rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Helper function to check if the user is an admin or authorized sync operator
    function isAuthorizedAdmin() {
      return request.auth != null && (
        request.auth.token.email == 'service_sync_operator@nilpha.com' ||
        request.auth.token.email == 'jagadbandhutum@gmail.com' ||
        request.auth.token.email == 'doctorapp0p@gmail.com' ||
        request.auth.token.email == 'moderator@nilpha.com' ||
        (firestore.exists(/databases/(default)/documents/profiles/$(request.auth.uid)) &&
         firestore.get(/databases/(default)/documents/profiles/$(request.auth.uid)).data.role == 'ADMIN') ||
        (firestore.exists(/databases/(default)/documents/profiles/$(request.auth.uid)) &&
         firestore.get(/databases/(default)/documents/profiles/$(request.auth.uid)).data.role == 'MODERATOR') ||
        (firestore.exists(/databases/(default)/documents/users/$(request.auth.uid)) &&
         firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'admin') ||
        (firestore.exists(/databases/(default)/documents/users/$(request.auth.uid)) &&
         firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'moderator')
      );
    }

    // Doctor profile images:
    // - Public read access: anyone visiting the website can view doctor profile photos
    // - Authenticated admin write: only authenticated admins/moderators can upload or update
    // - File validation: max size 5MB and must be an image content type
    match /doctors/{doctorId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null &&
        request.resource.size < 5 * 1024 * 1024 &&
        request.resource.contentType.matches('image/.*');
    }

    // Patient medical records, prescriptions, and lab reports:
    // - Structured path: medical_records/{userId}/{recordId}/{fileName}
    // - Private read: Only the owning authenticated patient (request.auth.uid == userId) or authorized admin
    // - Private write: Only the owning authenticated patient or authorized admin
    // - File validation: max size 15MB, images or PDF only
    match /medical_records/{userId}/{recordId}/{fileName} {
      allow read: if request.auth != null && (
        request.auth.uid == userId ||
        isAuthorizedAdmin()
      );
      allow write: if request.auth != null && (
        request.auth.uid == userId ||
        isAuthorizedAdmin()
      ) &&
      request.resource.size < 15 * 1024 * 1024 &&
      (request.resource.contentType.matches('image/.*') || request.resource.contentType == 'application/pdf');
    }

    // Default catch-all rule:
    // Prohibit unauthenticated access
    match /{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if isAuthorizedAdmin();
    }
  }
}
